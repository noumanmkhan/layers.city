{
  "page": {
    "title": "Fun maps",
    "city": "Vancouver",
    "description": "Vancouver’s local areas in silly-but-true maps: Tim Hortons vs Starbucks, hometown coffee, sushi vs pho, BC Liquor vs private stores, what each area calls 3-1-1 about, and more.",
    "lede": "The same local areas as the map, the UEL and Stanley Park included, counted in less serious ways. Each map is a head-to-head or a signature: what an area has more of than the rest of the city.",
    "unitName": "local area",
    "unitPlural": "local areas",
    "credits": "Shops, restaurants and courts © OpenStreetMap contributors (ODbL). 3-1-1 requests: City of Vancouver Open Data (Open Government Licence – Vancouver). EV chargers: Natural Resources Canada via the U.S. DOE Alternative Fuels Data Center. Counts are only as complete as their sources.",
    "refresh": "Refreshed every three months."
  },
  "units": {
    "nb": {
      "file": "local_areas.geojson",
      "key": "name",
      "label": "name",
      "one": "local area"
    },
    "wd": {
      "file": "local_areas.geojson",
      "key": "code",
      "label": "name",
      "one": "local area"
    }
  },
