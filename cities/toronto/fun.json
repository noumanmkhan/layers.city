    {
      "id": "311-signature",
      "type": "signature311",
      "title": "What each ward calls 311 about",
      "minTypeTotal": 1500,
      "minAreaCount": 60,
      "note": "Each ward is coloured by the kind of 311 call it makes far more often than the city as a whole, not its most common one (that's a broken bin lid almost everywhere). Hover or tap for the single most over-represented request. The City publishes 311 requests by ward, not by neighbourhood.",
      "themes": [
        [
          "Noise",
          "noise|amplified|sound"
        ],
        [
          "Wildlife",
          "wildlife|animal|dog |dogs|raccoon|coyote|bird|rodent|pest"
        ],
        [
          "Snow and ice",
          "snow|plow|salting|icy|windrow"
        ],
        [
          "Illegal dumping",
          "dumping"
        ],
        [
          "Graffiti and posters",
          "graffiti|poster"
        ],
        [
          "Parking",
          "parking"
        ],
        [
          "Bins and garbage",
          "bin|garbage|recycl|organic|yard waste|furniture|not picked up|collection|waste set out|hazardous waste|solid waste|oversized|litter"
        ],
        [
          "Trees",
          "tree|pruning|stump"
        ],
        [
          "Water and sewer",
          "water|sewer|catch basin|flood|hydrant|drain"
        ],
        [
          "Roads and sidewalks",
          "road|pothole|sidewalk|curb|pavement|street furniture|sign|signal|debris|boulevard|street light"
        ],
        [
          "Property and bylaws",
          "property|grass|zoning|encroachment|contractor|fence|pool|sign permit"
        ]
      ]
    },
    {
      "id": "parking-tickets",
      "type": "tickets",
      "title": "Parking tickets",
      "note": "Tickets are placed by matching the ticket's address to the City's address points; a ticket written at an intersection or a vague spot isn't counted."
    },
    {
      "id": "street-suffixes",
      "type": "suffix",
      "title": "Avenue, Crescent or Gardens?",
      "minNames": 3,
      "ignore": [
        "Other"
      ],
      "note": "Each neighbourhood's street ending that's most over-represented compared with the city, counted by distinct street name. Grid neighbourhoods lean Avenue; postwar suburbs lean Crescent, Court and Drive.",
      "maxCats": 10,
      "standouts": [
        "Crescent",
        "Court",
        "Gardens"
      ]
    }
