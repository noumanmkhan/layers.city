{
  "page": {
    "title": "Fun maps",
    "city": "Toronto",
    "description": "Toronto's neighbourhoods in silly-but-true maps: Tim Hortons vs Starbucks, LCBO vs cannabis, gas vs EV, what each ward calls 311 about, and more.",
    "lede": "The same 158 neighbourhoods as the map, counted in less serious ways. Each map is a head-to-head or a signature: what a neighbourhood has more of than the rest of the city.",
    "unitName": "neighbourhood",
    "unitPlural": "neighbourhoods",
    "credits": "Shops and restaurants © OpenStreetMap contributors (ODbL). 311 requests, parking tickets, street names, rec facilities and EV chargers: City of Toronto Open Data, NRCan/AFDC. Counts are only as complete as their sources.",
    "refresh": "Refreshed every three months."
  },
  "osm": "raw/fun/osm_places.json",
  "maps": [
    {
      "id": "tims-vs-starbucks",
      "type": "pair",
      "title": "Tim Hortons vs Starbucks",
      "a": {
        "label": "Tim Hortons",
        "brand": true,
        "short": "Tim's",
        "colour": "#C8102E",
        "osm": [
          {
            "brand": "^Tim Hortons$"
          },
          {
            "name": "^Tim Hortons"
          }
        ]
      },
      "b": {
        "label": "Starbucks",
        "brand": true,
        "colour": "#00704A",
        "osm": [
          {
            "brand": "^Starbucks$"
          },
          {
            "name": "^Starbucks"
          }
        ]
      }
    },
    {
      "id": "lcbo-vs-cannabis",
      "type": "pair",
      "title": "Liquor stores vs cannabis stores",
      "a": {
        "label": "Liquor, beer and wine stores",
        "short": "Liquor",
        "colour": "#7A1F5C",
        "osm": [
          {
            "shop": "^(alcohol|wine)$"
          }
        ]
      },
      "b": {
        "label": "Cannabis stores",
        "short": "Cannabis",
        "colour": "#3F8F3A",
