{
 "_about": "Settings for this city's discovery places layer (engine/discover/build.py), docs/toronto/data/discover.geojson: places the City describes in its own open data, plus hand-checked viewpoints, for Along the way and the app. No businesses on the website (the user, November 17, 2026: they're for the iOS app). Keys: sources (each a dataset: id, url, credit, licence; name, text, link and word = its columns, word joined with ' · '; lat and lon columns, or a GeoJSON 'geometry' column; keep = {column: regex} rows must match; skip = regex on the name to leave out; kinds = rules in order, the first that matches gives the kind: {kind, match: regex, field: column, default the name}, a rule with no match catches the rest); words = the line under the name when a source has none; dedupe_m = metres within which two rows with the same name are one place (the first source wins, later ones fill in a missing text or link); viewpoints = the hand-kept file of viewpoints. Kinds: art, history, park, library, view, community (what's left: community centres, schools, services, with no history in the name or text). The descriptions are the City's words, quoted with credit under the Open Government Licence - Toronto, never rewritten.",
 "about": "Places described by the City of Toronto (StrollTO, Public Art, Cultural Hotspot; Open Government Licence - Toronto) and viewpoints checked by Layers.City.",
 "words": {"art": "Public art", "history": "Local history", "park": "Park", "library": "Library", "view": "Viewpoint", "community": "Community"},
 "dedupe_m": 150,
 "viewpoints": "viewpoints.json",
 "sources": [
  {
   "id": "strollto",
   "url": "https://ckan0.cf.opendata.inter.prod-toronto.ca/dataset/f87fbe88-f9d1-432d-a482-b7044b32d587/resource/b30cc1eb-6385-4bf4-8231-20d3e9ec4021/download/strollto-poi-details-4326.csv",
   "credit": "City of Toronto, StrollTO",
   "licence": "Open Government Licence - Toronto",
   "name": "Title", "text": "Description", "link": "Link_URL",
   "skip": "(?i)^(?!(former|historic|the historic|site of)\\b).*\\b(restaurant|caf[eé]|coffee|bakery|deli|pizzeria|bistro|brewery|flea market)\\b",
   "kinds": [
    {"kind": "art", "match": "(?i)mural|artbox|art box|sculpture|statue|installation|memorial|monument|cenotaph|'[^']+'"},
    {"kind": "library", "match": "(?i)librar"},
    {"kind": "history", "match": "(?i)\\bstation\\b"},
    {"kind": "park", "match": "(?i)\\bpark\\b|parkette|gardens?\\b|ravine|\\btrail\\b|beach|creek|\\bwoods\\b|valley|bluffs|marsh|meadow|\\bponds?\\b"},
    {"kind": "history", "match": "(?i)\\b(former|historic|heritage|plaque|house|homestead|cottage|church|cathedral|synagogue|temple|mosque|cemetery|burial|museum|theatre|hall|bridge|mill|farm|estate|station|tower|lane)\\b"},
    {"kind": "history", "field": "Description", "match": "\\b(1[6-8]\\d\\d|19[0-7]\\d)\\b"},
    {"kind": "community"}
   ]
  },
  {
   "id": "publicart",
   "url": "https://ckan0.cf.opendata.inter.prod-toronto.ca/dataset/bfdc6aa8-7ea6-4225-a3f7-e13d1d2b4018/resource/2cb2c65a-1565-4382-8fe3-3a235aec7655/download/public-art-4326.csv",
   "credit": "City of Toronto, Public Art",
   "licence": "Open Government Licence - Toronto",
   "name": "TITLE", "text": "DESCRIPTION", "link": "EXTERNAL_LINK", "lat": "LATITUDE", "lon": "LONGITUDE",
   "word": ["ARTWORK_TYPE", "YEAR", "ARTIST"], "flip": ["ARTIST"],
   "kinds": [{"kind": "art"}]
  },
  {
   "id": "hotspot",
   "url": "https://ckan0.cf.opendata.inter.prod-toronto.ca/dataset/c7be2ee7-d317-4a28-8cbe-bff1ce116b46/resource/70eb3e9e-47c1-4254-9f78-ebcad6df29e9/download/cultural-loop-tour-points-4326.csv",
   "credit": "City of Toronto, Cultural Hotspot",
   "licence": "Open Government Licence - Toronto",
   "name": "SiteName", "text": "Description", "link": "ExternalLink", "lat": "Latitude", "lon": "Longitude",
   "keep": {"EntryType": "(?i)^\\s*destination"},
   "skip": "(?i)^(?!(former|historic|the historic|site of)\\b).*\\b(restaurant|caf[eé]|coffee|bakery|deli|pizzeria|bistro|brewery|flea market)\\b",
   "kinds": [
    {"kind": "library", "match": "(?i)librar"},
    {"kind": "art", "field": "Interests", "match": "Art|Mural"},
    {"kind": "park", "field": "Interests", "match": "Nature"},
    {"kind": "history", "field": "Interests", "match": "History|Architecture"},
    {"kind": "history", "match": "(?i)\\b(former|historic|heritage|plaque|house|homestead|cottage|church|cathedral|synagogue|temple|mosque|cemetery|burial|museum|theatre|hall|bridge|mill|farm|estate|station|tower|lane)\\b"},
    {"kind": "history", "field": "Description", "match": "\\b(1[6-8]\\d\\d|19[0-7]\\d)\\b"},
    {"kind": "community"}
   ]
  }
 ]
}
