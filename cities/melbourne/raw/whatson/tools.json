{
 "jsonrpc": "2.0",
 "id": 3,
 "result": {
  "tools": [
   {
    "name": "search_tool",
    "description": "Search for events, attractions, restaurants, and other listings on What's On Melbourne",
    "inputSchema": {
     "$schema": "https://json-schema.org/draft/2020-12/schema",
     "properties": {
      "query": {
       "type": "string",
       "description": "Search query text"
      },
      "category": {
       "type": "string",
       "enum": [
        "anything",
        "things_to_do",
        "eat_and_drink",
        "shopping",
        "hotels",
        "guides"
       ],
       "description": "Category to filter results"
      },
      "sub_categories": {
       "type": "array",
       "items": {
        "type": "string"
       },
       "description": "Sub-categories to filter results (e.g., ['cafe', 'bar_and_pub'])"
      },
      "locations": {
       "type": "array",
       "items": {
        "type": "string"
       },
       "description": "Locations to filter results (e.g., ['carlton', 'docklands'])"
      },
      "date_keyword": {
       "type": "string",
       "enum": [
        "any_day",
        "today",
        "tomorrow",
        "this_weekend",
        "specific_dates"
       ],
       "description": "Date filter keyword"
      },
      "date_range": {
       "type": "string",
       "description": "Date range in format 'YYYY-MM-DD' or 'YYYY-MM-DD to YYYY-MM-DD' (required if date_keyword is 'specific_dates')"
      },
      "page_number": {
       "type": "integer",
       "description": "Page number for pagination (default: 1)"
      },
      "tags_keys": {
       "type": "array",
       "items": {
        "type": "string"
       },
       "description": "Tag keys to filter results"
      },
      "accessibility_features": {
       "type": "array",
       "items": {
        "type": "string"
       },
       "description": "Accessibility features to filter results"
      }
     },
     "type": "object"
    }
   },
   {
    "name": "get_categories_tool",
    "description": "Get all available search categories",
    "inputSchema": {
     "$schema": "https://json-schema.org/draft/2020-12/schema",
     "type": "object"
    }
   },
   {
    "name": "get_sub_categories_tool",
    "description": "Get available sub-categories, optionally filtered by category",
    "inputSchema": {
     "$schema": "https://json-schema.org/draft/2020-12/schema",
     "properties": {
      "category": {
       "type": "string",
       "enum": [
        "anything",
        "things_to_do",
        "eat_and_drink",
        "shopping",
        "hotels",
        "guides"
       ],
       "description": "Optional category to filter sub-categories"
      }
     },
     "type": "object"
    }
   },
   {
    "name": "get_locations_tool",
    "description": "Get all available search locations",
    "inputSchema": {
     "$schema": "https://json-schema.org/draft/2020-12/schema",
     "type": "object"
    }
   },
   {
    "name": "get_date_keywords_tool",
    "description": "Get all available date filter keywords",
    "inputSchema": {
     "$schema": "https://json-schema.org/draft/2020-12/schema",
     "type": "object"
    }
   },
   {
    "name": "get_tags_tool",
    "description": "Get available tag keys that can be used in search filters",
    "inputSchema": {
     "$schema": "https://json-schema.org/draft/2020-12/schema",
     "type": "object"
    }
   },
   {
    "name": "get_accessibility_features_tool",
    "description": "Get all available accessibility features for filtering search results",
    "inputSchema": {
     "$schema": "https://json-schema.org/draft/2020-12/schema",
     "type": "object"
    }
   }
  ]
 }
}