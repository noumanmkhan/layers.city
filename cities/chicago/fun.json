          {
            "brand": "^Giordano'?s( Pizzeria)?$"
          },
          {
            "name": "^Giordano'?s"
          }
        ]
      },
      "note": "Counts each chain's restaurants inside the city; most community areas have neither."
    },
    {
      "id": "jewel-vs-marianos",
      "type": "pair",
      "title": "Jewel vs Mariano's",
      "a": {
        "label": "Jewel-Osco",
        "brand": true,
        "short": "Jewel",
        "colour": "#D2232A",
        "osm": [
          {
            "shop": "^supermarket$",
            "brand": "^Jewel"
          },
          {
            "shop": "^supermarket$",
            "name": "^Jewel"
          }
        ]
      },
      "b": {
        "label": "Mariano's",
        "brand": true,
        "colour": "#2E6B3F",
        "osm": [
          {
            "shop": "^supermarket$",
            "brand": "^Mariano'?s"
          },
          {
            "shop": "^supermarket$",
            "name": "^Mariano'?s"
          }
        ]
      },
      "note": "Counts each chain's supermarkets inside the city."
    },
    {
      "id": "tennis-vs-pickleball",
      "type": "pair",
      "title": "Tennis vs pickleball",
      "a": {
        "label": "Parks with tennis courts",
        "short": "Tennis",
        "colour": "#7FA51F",
        "layer": "sports.geojson",
        "has": "tennis"
      },
      "b": {
        "label": "Parks with pickleball courts",
        "short": "Pickleball",
        "colour": "#1F8FA5",
        "layer": "sports.geojson",
        "has": "pickleball"
      },
      "note": "Counts parks, not courts, from OpenStreetMap as on the map's Sports & rec layer. Many have both."
    },
    {
      "id": "gas-vs-ev",
      "type": "pair",
      "title": "Gas stations vs EV chargers",
      "a": {
        "label": "Gas stations",
        "colour": "#D9822B",
        "osm": [
          {
            "amenity": "^fuel$"
          }
        ]
      },
      "b": {
        "label": "Public EV charging sites",
        "short": "EV chargers",
        "colour": "#1F6FB5",
        "layer": "parking.geojson",
        "where": {
          "c": "ev"
        }
      },
      "note": "EV counts are charging sites (not plugs) open to the public, the same list as the map's EV chargers layer."
    },
    {
      "id": "311-signature",
      "type": "signature311",
      "title": "What each community area calls 311 about",
      "minTypeTotal": 1000,
      "minAreaCount": 40,
      "note": "Each community area is coloured by the kind of 311 request it makes far more often than the city as a whole, not its most common one. Hover or tap for the single most over-represented request. Aircraft noise complaints (all filed at O'Hare), information-only calls and requests about people are left out.",
