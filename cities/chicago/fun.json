{
  "page": {
    "title": "Fun maps",
    "city": "Chicago",
    "description": "Chicago's community areas in silly-but-true maps: Dunkin' vs Starbucks, Lou Malnati's vs Giordano's, Jewel vs Mariano's, tennis vs pickleball, and what each community area calls 311 about.",
    "lede": "The same 77 community areas as the map, counted in less serious ways. Each map is a head-to-head or a signature: what a community area has more of than the rest of the city.",
    "unitName": "community area",
    "unitPlural": "community areas",
    "credits": "Shops and restaurants © OpenStreetMap contributors (ODbL). 311 requests: City of Chicago Data Portal. Courts: OpenStreetMap, as on the map's Sports & rec layer. EV chargers: U.S. DOE Alternative Fuels Data Center. Counts are only as complete as their sources.",
    "refresh": "Refreshed every three months."
  },
  "units": {
    "nb": {
      "file": "community_areas.geojson",
      "key": "name",
      "label": "name",
      "one": "community area"
    },
    "wd": {
      "file": "community_areas.geojson",
      "key": "code",
      "label": "name",
      "one": "community area"
    }
  },
  "maps": [
    {
      "id": "dunkin-vs-starbucks",
      "type": "pair",
      "title": "Dunkin' vs Starbucks",
      "a": {
        "label": "Dunkin'",
        "brand": true,
        "colour": "#E8559A",
        "osm": [
          {
            "brand": "^Dunkin'?( Donuts)?$"
          },
          {
            "name": "^Dunkin"
          }
        ]
      },
      "b": {
        "label": "Starbucks",
        "brand": true,
        "colour": "#00704A",
        "osm": [
          {
            "brand": "^Starbucks$"
          },
          {
            "name": "^Starbucks"
          }
        ]
      }
    },
    {
      "id": "malnatis-vs-giordanos",
      "type": "pair",
