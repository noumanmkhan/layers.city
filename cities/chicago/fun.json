      "a": {
        "label": "Lou Malnati's",
        "brand": true,
        "short": "Lou's",
        "colour": "#1F5F3A",
        "osm": [
          {
            "brand": "^Lou Malnati'?s( Pizzeria)?$"
          },
          {
            "name": "^Lou Malnati"
          }
        ]
      },
      "b": {
        "label": "Giordano's",
        "brand": true,
        "colour": "#C8102E",
